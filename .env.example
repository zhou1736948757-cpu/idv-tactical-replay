# HTTP port exposed on the host for Nginx frontend/reverse-proxy
HTTP_PORT=80

# Runtime environment: production | development
IDV_ENV=production

# Public match list visibility for user-uploaded replays:
# 0 = hide uploaded matches from GET /api/matches (direct share links still work)
# 1 = list uploaded matches publicly in GET /api/matches
IDV_PUBLIC_UPLOADS=0

# Mask player unique_id values on newly uploaded replays (1 = mask, 0 = keep raw)
IDV_REDACT_UID=1

# Disable FastAPI /docs, /redoc, /openapi.json (defaults to 1 in production)
IDV_DISABLE_DOCS=1

# Comma-separated CORS origin allowlist (empty = same-origin via Nginx reverse proxy)
IDV_CORS_ORIGINS=

# Upload & resource safety limits
IDV_MAX_UPLOAD_BYTES=268435456
IDV_MAX_MATCHES_PER_UPLOAD=5
IDV_MAX_CONCURRENT_EXTRACTS=2
IDV_MAX_UPLOADED_MATCHES=500

# Frontend build-time API base path
VITE_API_BASE=/api
