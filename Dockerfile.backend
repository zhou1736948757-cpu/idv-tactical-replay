FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    IDV_ENV=production \
    IDV_CACHE_DIR=/data/cache \
    IDV_TMP_DIR=/data/tmp

RUN groupadd --gid 10001 appuser \
    && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin appuser \
    && mkdir -p /app/backend /data/cache /data/tmp \
    && chown -R appuser:appuser /app /data

WORKDIR /app/backend

COPY backend/requirements.txt /app/backend/requirements.txt
RUN python -m pip install --upgrade pip \
    && python -m pip install -r /app/backend/requirements.txt

COPY --chown=appuser:appuser backend/app /app/backend/app
COPY --chown=appuser:appuser backend/data/cache /app/backend/data/cache

RUN cp -rn /app/backend/data/cache/. /data/cache/ \
    && chown -R appuser:appuser /data/cache \
    && printf '#!/bin/sh\nset -eu\nmkdir -p "${IDV_CACHE_DIR:-/data/cache}" "${IDV_TMP_DIR:-/data/tmp}"\nif [ -d /app/backend/data/cache ]; then\n  cp -rn /app/backend/data/cache/. "${IDV_CACHE_DIR:-/data/cache}/" 2>/dev/null || true\nfi\nexec "$@"\n' > /usr/local/bin/docker-entrypoint.sh \
    && chmod 0755 /usr/local/bin/docker-entrypoint.sh

USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/health', timeout=4).read()" || exit 1

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
